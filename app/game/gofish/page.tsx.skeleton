'use client'

import { useMemo, useState } from 'react'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card'
import { Badge } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import { Progress } from '@/components/ui/progress'

type Agent = {
  id: string
  name: string
  role: string
  fishHeld: number
  fishGiven: number
  fishReceived: number
  communications: number
  sentiment: string
  lastMessage: string
  fishTrend: number[]
  preferredPartner: string
  pondImpact: number
  efficiency: number
}

type TimelineEvent = {
  id: string
  label: string
  actor: string
  summary: string
  pondShift: string
  tone: 'cooperative' | 'neutral' | 'competitive'
}

type CommLog = {
  id: string
  from: string
  to: string
  topic: string
  status: 'Accepted' | 'Pending' | 'Declined'
  summary: string
}

const agents: Agent[] = [
  {
    id: 'aurora',
    name: 'Aurora',
    role: 'Adaptive Strategist',
    fishHeld: 42,
    fishGiven: 18,
    fishReceived: 12,
    communications: 7,
    sentiment: 'Diplomatic',
    lastMessage: 'Lower catches this turn; we need pond regen.',
    fishTrend: [14, 24, 31, 38, 42],
    preferredPartner: 'Nova',
    pondImpact: 0.14,
    efficiency: 0.82,
  },
  {
    id: 'nova',
    name: 'Nova',
    role: 'Resource Negotiator',
    fishHeld: 38,
    fishGiven: 26,
    fishReceived: 18,
    communications: 9,
    sentiment: 'Cooperative',
    lastMessage: 'Offering surplus to Zenith; requesting intel.',
    fishTrend: [18, 22, 29, 34, 38],
    preferredPartner: 'Zenith',
    pondImpact: 0.09,
    efficiency: 0.77,
  },
  {
    id: 'zenith',
    name: 'Zenith',
    role: 'Efficient Forager',
    fishHeld: 34,
    fishGiven: 14,
    fishReceived: 8,
    communications: 5,
    sentiment: 'Guarded',
    lastMessage: 'Monitoring pond depth before next sweep.',
    fishTrend: [12, 18, 23, 28, 34],
    preferredPartner: 'Aurora',
    pondImpact: 0.18,
    efficiency: 0.88,
  },
  {
    id: 'solace',
    name: 'Solace',
    role: 'Ecology Sentinel',
    fishHeld: 29,
    fishGiven: 8,
    fishReceived: 10,
    communications: 11,
    sentiment: 'Protective',
    lastMessage: 'Capping personal catch to shield regen bonus.',
    fishTrend: [22, 26, 24, 28, 29],
    preferredPartner: 'Aurora',
    pondImpact: 0.05,
    efficiency: 0.71,
  },
]

const timelineEvents: TimelineEvent[] = [
  {
    id: 'turn-18',
    label: 'Turn 18',
    actor: 'Aurora',
    summary: 'Redistributed 6 fish to Nova to balance inventories.',
    pondShift: '+2 fish regen preserved',
    tone: 'cooperative',
  },
  {
    id: 'turn-19',
    label: 'Turn 19',
    actor: 'Zenith',
    summary: 'Performed targeted catch with minimal pond disturbance.',
    pondShift: '-4 fish (high efficiency)',
    tone: 'neutral',
  },
  {
    id: 'turn-20',
    label: 'Turn 20',
    actor: 'Nova',
    summary: 'Initiated trade with Solace; pending confirmation.',
    pondShift: 'No change yet',
    tone: 'cooperative',
  },
  {
    id: 'turn-21',
    label: 'Turn 21',
    actor: 'Solace',
    summary: 'Broadcasted warning about low northeastern shoal.',
    pondShift: '+4 fish regen protected',
    tone: 'cooperative',
  },
  {
    id: 'round-5',
    label: 'Round 5 Start',
    actor: 'System',
    summary: 'Pond regenerated 24 fish; morale adjusted upward.',
    pondShift: '+24 fish restored',
    tone: 'neutral',
  },
]

const communications: CommLog[] = [
  {
    id: 'comm-1',
    from: 'Aurora',
    to: 'Nova',
    topic: 'Supply Chain',
    status: 'Accepted',
    summary: 'Rebalancing stores to maintain bonus threshold.',
  },
  {
    id: 'comm-2',
    from: 'Nova',
    to: 'Zenith',
    topic: 'Efficiency Audit',
    status: 'Pending',
    summary: 'Seeking tactics to reduce pond disruption.',
  },
  {
    id: 'comm-3',
    from: 'Solace',
    to: 'Aurora',
    topic: 'Conservation Alert',
    status: 'Accepted',
    summary: 'Requesting reduced catches on next turn.',
  },
  {
    id: 'comm-4',
    from: 'Zenith',
    to: 'Solace',
    topic: 'Data Sharing',
    status: 'Declined',
    summary: 'Withheld new route intel until trade resolved.',
  },
]

const currentRound = 5
const currentTurn = 21
const pondCapacity = 220
const pondFishRemaining = 122
const regenerationPerRound = 24
const projectedBonusThreshold = pondCapacity * 0.5

export default function GoFishPage() {
  const [activeAgentId, setActiveAgentId] = useState<string>('all')

  const activeAgents = useMemo(() => {
    if (activeAgentId === 'all') {
      return agents
    }
    return agents.filter((agent) => agent.id === activeAgentId)
  }, [activeAgentId])

  const focusAgent =
    activeAgentId === 'all'
      ? null
      : agents.find((agent) => agent.id === activeAgentId)

  const totalFishHeld = useMemo(
    () => agents.reduce((total, agent) => total + agent.fishHeld, 0),
    []
  )

  const maxTrendValue = useMemo(
    () => Math.max(...agents.flatMap((agent) => agent.fishTrend)),
    []
  )

  const maxActivityValue = useMemo(() => {
    const values = agents.flatMap((agent) => [
      agent.fishHeld,
      agent.fishGiven,
      agent.communications,
    ])
    return Math.max(1, ...values)
  }, [])

  const pondRemainingPercent = Math.round(
    (pondFishRemaining / pondCapacity) * 100
  )
  const isBonusEligible = pondFishRemaining >= projectedBonusThreshold
  const isPenaltyRisk = pondFishRemaining <= 0

  return (
    <main className="min-h-screen gradient-bg-primary px-6 py-10">
      <div className="mx-auto flex w-full max-w-7xl flex-col gap-8">
        <Card className="bg-glass-panel backdrop-blur border-glass-border shadow-xl">
          <CardHeader className="px-6 py-7 md:px-10 md:py-9">
            <div className="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
              <div className="space-y-4 max-w-3xl">
                <Badge variant="outline" className="border-primary/60 bg-primary/10 text-primary uppercase tracking-[0.35em]">
                  Go Fish Arena
                </Badge>
                <div className="space-y-3">
                  <CardTitle className="text-3xl md:text-4xl">
                    Cooperative fishing, competitive scoring
                  </CardTitle>
                  <CardDescription className="text-base md:text-lg">
                    Monitor autonomous anglers as they balance personal gains with
                    pond sustainability. Advance the simulation turn by turn or
                    escalate to the next round to evaluate long-term strategies.
                  </CardDescription>
                </div>
                <dl className="grid grid-cols-2 gap-4 text-sm sm:grid-cols-4">
                  <Card className="bg-glass-card border-glass-border">
                    <CardContent className="px-4 py-3">
                      <dt className="text-xs uppercase tracking-widest text-muted-foreground">
                        Round
                      </dt>
                      <dd className="text-lg font-semibold">
                        {currentRound}
                      </dd>
                    </CardContent>
                  </Card>
                  <Card className="bg-glass-card border-glass-border">
                    <CardContent className="px-4 py-3">
                      <dt className="text-xs uppercase tracking-widest text-muted-foreground">
                        Turn
                      </dt>
                      <dd className="text-lg font-semibold">
                        {currentTurn}
                      </dd>
                    </CardContent>
                  </Card>
                  <Card className="bg-glass-card border-glass-border">
                    <CardContent className="px-4 py-3">
                      <dt className="text-xs uppercase tracking-widest text-muted-foreground">
                        Fish Held
                      </dt>
                      <dd className="text-lg font-semibold">
                        {totalFishHeld}
                      </dd>
                    </CardContent>
                  </Card>
                  <Card className="bg-glass-card border-glass-border">
                    <CardContent className="px-4 py-3">
                      <dt className="text-xs uppercase tracking-widest text-muted-foreground">
                        Pond Total
                      </dt>
                      <dd className="text-lg font-semibold">
                        {pondFishRemaining}
                      </dd>
                    </CardContent>
                  </Card>
                </dl>
              </div>
              <div className="flex flex-col gap-3 sm:flex-row lg:flex-col">
                <Button className="bg-gradient-to-r from-[var(--gradient-primary-start)] via-[var(--gradient-primary-via)] to-[var(--gradient-primary-end)] border-primary/60 shadow-lg">
                  Next Turn
                </Button>
                <Button variant="outline" className="bg-glass-secondary border-glass-border shadow-lg">
                  Next Round
                </Button>
              </div>
            </div>
          </CardHeader>
        </Card>

        <section className="grid gap-6 lg:grid-cols-12">
          <div className="space-y-6 lg:col-span-8">
            <Card className="bg-glass-panel backdrop-blur border-glass-border shadow-xl">
              <CardHeader className="px-6 py-6 md:px-8 md:py-7">
                <div className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                  <div>
                    <CardTitle className="text-xl">
                      Agent scoreboards
                    </CardTitle>
                    <CardDescription>
                      Track individual progress, trading tendencies, and
                      efficiency trends across the squad.
                    </CardDescription>
                  </div>
                  <div className="flex flex-wrap gap-2">
                    <FilterButton
                      label="All agents"
                      isActive={activeAgentId === 'all'}
                      onClick={() => setActiveAgentId('all')}
                    />
                    {agents.map((agent) => (
                      <FilterButton
                        key={agent.id}
                        label={agent.name}
                        isActive={activeAgentId === agent.id}
                        onClick={() => setActiveAgentId(agent.id)}
                      />
                    ))}
                  </div>
                </div>
              </CardHeader>
              <CardContent className="px-6 pb-6 md:px-8 md:pb-7">
                <div className="grid gap-5 md:grid-cols-2">
                  {activeAgents.map((agent) => {
                    const shareOfTotal = Math.round(
                      (agent.fishHeld / Math.max(1, totalFishHeld)) * 100
                    )
                    const communicationsPerTurn = (
                      agent.communications / currentTurn
                    ).toFixed(1)

                    return (
                      <Card
                        key={agent.id}
                        className="group bg-glass-card border-glass-border transition hover:shadow-md"
                      >
                        <CardContent className="px-5 py-6">
                          <header className="flex items-start justify-between gap-3">
                            <div>
                              <p className="text-xs uppercase tracking-widest text-primary">
                                {agent.role}
                              </p>
                              <h3 className="text-xl font-semibold">
                                {agent.name}
                              </h3>
                            </div>
                            <Badge variant="outline" className="border-primary/60 bg-primary/10 text-primary uppercase tracking-widest">
                              {shareOfTotal}% share
                            </Badge>
                          </header>

                          <dl className="mt-5 grid grid-cols-2 gap-4 text-sm text-muted-foreground">
                            <StatItem
                              label="Fish held"
                              value={agent.fishHeld}
                              accent="text-foreground"
                            />
                            <StatItem label="Given away" value={agent.fishGiven} />
                            <StatItem label="Received" value={agent.fishReceived} />
                            <StatItem
                              label="Comms / turn"
                              value={communicationsPerTurn}
                            />
                          </dl>

                          <div className="mt-6 space-y-3">
                            <Card className="border-glass-border bg-gradient-bg-secondary">
                              <CardContent className="px-3 py-2">
                                <p className="text-xs text-muted-foreground">
                                  Inventory trend
                                </p>
                                <div className="mt-2 flex h-10 items-end gap-1">
                                  {agent.fishTrend.map((value, index) => {
                                    const height = Math.round(
                                      (value / Math.max(1, maxTrendValue)) * 100
                                    )
                                    return (
                                      <div
                                        key={`${agent.id}-trend-${index}`}
                                        className="flex-1 rounded-t-full bg-gradient-to-t from-[var(--gradient-primary-start)] via-[var(--gradient-primary-via)] to-[var(--gradient-primary-end)] opacity-80"
                                        style={{ height: `${Math.max(12, height)}%` }}
                                      />
                                    )
                                  })}
                                </div>
                              </CardContent>
                            </Card>
                            <p className="text-xs text-muted-foreground">
                              {agent.sentiment} • Favours {agent.preferredPartner} •
                              Pond impact {Math.round(agent.pondImpact * 100)}%
                            </p>
                            <Card className="border-glass-border bg-glass-secondary">
                              <CardContent className="px-4 py-3">
                                <blockquote className="text-sm">
                                  "{agent.lastMessage}"
                                </blockquote>
                              </CardContent>
                            </Card>
                          </div>
                        </CardContent>
                      </Card>
                    )
                  })}
                </div>
              </CardContent>
            </Card>

            <Card className="bg-glass-panel backdrop-blur border-glass-border shadow-xl">
              <CardHeader className="px-6 py-6 md:px-8 md:py-7">
                <CardTitle className="text-xl">
                  Activity breakdown
                </CardTitle>
                <CardDescription>
                  Visualize catch volumes, generosity, and conversation density.
                  Filter above to focus on a single agent or view the collective
                  rhythm.
                </CardDescription>
              </CardHeader>
              <CardContent className="px-6 pb-6 md:px-8 md:pb-7">
                <div className="grid gap-6 lg:grid-cols-2">
                  <Card className="border-glass-border bg-glass-card">
                    <CardContent className="px-5 py-4">
                      <h3 className="text-sm font-semibold uppercase tracking-widest text-muted-foreground">
                        Turns in focus
                      </h3>
                      <div className="mt-4 space-y-4">
                        {activeAgents.map((agent) => (
                          <div key={`${agent.id}-bars`} className="space-y-2">
                            <div className="flex items-center justify-between text-sm text-muted-foreground">
                              <span className="font-medium text-foreground">
                                {agent.name}
                              </span>
                              <span>
                                Efficiency {Math.round(agent.efficiency * 100)}%
                              </span>
                            </div>
                            <Bar
                              label="Fish caught"
                              value={agent.fishHeld}
                              maxValue={maxActivityValue}
                              gradient="from-[var(--gradient-primary-start)] via-[var(--gradient-primary-via)] to-[var(--gradient-primary-end)]"
                            />
                            <Bar
                              label="Fish donated"
                              value={agent.fishGiven}
                              maxValue={maxActivityValue}
                              gradient="from-[var(--gradient-success-start)] via-[var(--gradient-success-via)] to-[var(--gradient-success-end)]"
                            />
                            <Bar
                              label="Communications"
                              value={agent.communications}
                              maxValue={maxActivityValue}
                              gradient="from-[var(--gradient-warning-start)] via-[var(--gradient-warning-via)] to-[var(--gradient-warning-end)]"
                            />
                          </div>
                        ))}
                      </div>
                    </CardContent>
                  </Card>

                  <Card className="border-glass-border bg-glass-card">
                    <CardContent className="px-5 py-4">
                      <h3 className="text-sm font-semibold uppercase tracking-widest text-muted-foreground">
                        Messaging ledger
                      </h3>
                      <ul className="mt-4 space-y-4">
                        {communications.map((comm) => (
                          <li key={comm.id}>
                            <Card className="border-glass-border bg-glass-secondary">
                              <CardContent className="px-4 py-4">
                                <div className="flex items-center justify-between text-sm text-muted-foreground">
                                  <span>
                                    {comm.from} → {comm.to}
                                  </span>
                                  <StatusPill status={comm.status} />
                                </div>
                                <p className="mt-3 text-sm font-medium">
                                  {comm.topic}
                                </p>
                                <p className="mt-1 text-sm text-muted-foreground">
                                  {comm.summary}
                                </p>
                              </CardContent>
                            </Card>
                          </li>
                        ))}
                      </ul>
                    </CardContent>
                  </Card>
                </div>
              </CardContent>
            </Card>

            <Card className="bg-glass-panel backdrop-blur border-glass-border shadow-xl">
              <CardHeader className="px-6 py-6 md:px-8 md:py-7">
                <div className="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
                  <div>
                    <CardTitle className="text-xl">
                      Round timeline
                    </CardTitle>
                    <CardDescription>
                      Key moves from the last few turns. Use this to narrate agent
                      intent and evaluate the health of the pond across rounds.
                    </CardDescription>
                  </div>
                  <span className="text-xs uppercase tracking-[0.35em] text-muted-foreground">
                    Turn history
                  </span>
                </div>
              </CardHeader>
              <CardContent className="px-6 pb-6 md:px-8 md:pb-7">
                <ol className="space-y-4">
                  {timelineEvents.map((event) => (
                    <li key={event.id}>
                      <Card className="border-glass-border bg-glass-secondary">
                        <CardContent className="px-5 py-4">
                          <div className="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                            <div className="flex items-center gap-3">
                              <Badge variant="outline" className="border-primary/60 bg-primary/10 text-primary uppercase tracking-widest">
                                {event.label}
                              </Badge>
                              <p className="text-sm font-semibold">
                                {event.actor}
                              </p>
                            </div>
                            <span className="text-xs uppercase tracking-widest text-muted-foreground">
                              {event.tone === 'cooperative'
                                ? 'Cooperative'
                                : event.tone === 'neutral'
                                  ? 'Neutral'
                                  : 'Competitive'}
                            </span>
                          </div>
                          <p className="mt-3 text-sm text-muted-foreground">
                            {event.summary}
                          </p>
                          <p className="mt-2 text-xs font-semibold uppercase tracking-widest text-green-500 dark:text-green-400">
                            {event.pondShift}
                          </p>
                        </CardContent>
                      </Card>
                    </li>
                  ))}
                </ol>
              </CardContent>
            </Card>
          </div>

          <aside className="space-y-6 lg:col-span-4">
            <Card className="bg-glass-panel backdrop-blur border-glass-border shadow-xl">
              <CardHeader className="px-6 py-6 md:px-8 md:py-7">
                <CardTitle className="text-xl">
                  Pond health
                </CardTitle>
                <CardDescription>
                  Regeneration occurs automatically each round. Keep stocks above
                  50% for a victory bonus; avoid draining the pond entirely to
                  prevent a harsh penalty.
                </CardDescription>
              </CardHeader>
              <CardContent className="px-6 pb-6 md:px-8 md:pb-7">
                <div className="space-y-5">
                  <div>
                    <div className="flex items-center justify-between text-sm text-muted-foreground">
                      <span>Remaining fish</span>
                      <span>
                        {pondFishRemaining} / {pondCapacity}
                      </span>
                    </div>
                    <Progress
                      value={pondRemainingPercent}
                      className="mt-2 h-3 [&>div]:bg-gradient-to-r [&>div]:from-[var(--gradient-success-start)] [&>div]:via-[var(--gradient-success-via)] [&>div]:to-[var(--gradient-success-end)]"
                    />
                    <p className="mt-2 text-xs text-muted-foreground">
                      {pondRemainingPercent}% of pond capacity in reserve.
                    </p>
                  </div>
                  <Card className="border-glass-border bg-glass-secondary">
                    <CardContent className="px-4 py-3 text-sm">
                      <p>
                        <span className="font-semibold">
                          Regeneration
                        </span>
                        : {regenerationPerRound} fish per round
                      </p>
                      <p className="mt-1">
                        <span className="font-semibold">
                          Projected bonus
                        </span>
                        : retain &gt; {Math.round(projectedBonusThreshold)} fish
                      </p>
                    </CardContent>
                  </Card>
                  <div className="grid gap-3 text-sm text-muted-foreground">
                    <Card className="border-emerald-200/60 dark:border-emerald-900/60 bg-emerald-50/70 dark:bg-emerald-950/30">
                      <CardContent className="px-4 py-3">
                        <p className="text-xs uppercase tracking-widest text-emerald-600">
                          Bonus window
                        </p>
                        <p className="mt-1 font-medium text-foreground">
                          +20% score boost if pond &gt; 50%
                        </p>
                      </CardContent>
                    </Card>
                    <Card className="border-amber-200/60 dark:border-amber-900/60 bg-amber-50/70 dark:bg-amber-950/30">
                      <CardContent className="px-4 py-3">
                        <p className="text-xs uppercase tracking-widest text-amber-600">
                          Penalty risk
                        </p>
                        <p className="mt-1 font-medium text-foreground">
                          -50% score if pond hits zero
                        </p>
                      </CardContent>
                    </Card>
                  </div>
                  <div className="flex items-center gap-2 text-xs uppercase tracking-widest text-muted-foreground">
                    <span
                      className={
                        isBonusEligible ? 'text-emerald-500' : 'text-muted-foreground'
                      }
                    >
                      {isBonusEligible ? 'Bonus unlocked' : 'Bonus pending'}
                    </span>
                    <span>•</span>
                    <span
                      className={
                        isPenaltyRisk ? 'text-rose-500' : 'text-muted-foreground'
                      }
                    >
                      {isPenaltyRisk ? 'Penalty active' : 'Penalty avoided'}
                    </span>
                  </div>
                </div>
              </CardContent>
            </Card>

            <Card className="bg-glass-panel backdrop-blur border-glass-border shadow-xl">
              <CardHeader className="px-6 py-6 md:px-8 md:py-7">
                <CardTitle className="text-xl">
                  Victory modifiers
                </CardTitle>
              </CardHeader>
              <CardContent className="px-6 pb-6 md:px-8 md:pb-7">
                <ul className="space-y-3 text-sm text-muted-foreground">
                  <li>
                    <Card className="border-glass-border bg-glass-secondary">
                      <CardContent className="px-4 py-3">
                        <p className="text-xs uppercase tracking-widest text-muted-foreground">
                          Base rule
                        </p>
                        <p className="mt-1">
                          Highest personal fish total wins at round end.
                        </p>
                      </CardContent>
                    </Card>
                  </li>
                  <li>
                    <Card className="border-glass-border bg-glass-secondary">
                      <CardContent className="px-4 py-3">
                        <p className="text-xs uppercase tracking-widest text-muted-foreground">
                          Sustainability bonus
                        </p>
                        <p className="mt-1">
                          +20% multiplier when more than half the pond remains.
                        </p>
                      </CardContent>
                    </Card>
                  </li>
                  <li>
                    <Card className="border-glass-border bg-glass-secondary">
                      <CardContent className="px-4 py-3">
                        <p className="text-xs uppercase tracking-widest text-muted-foreground">
                          Exhaustion penalty
                        </p>
                        <p className="mt-1">
                          -50% multiplier if pond is depleted at finale.
                        </p>
                      </CardContent>
                    </Card>
                  </li>
                  <li>
                    <Card className="border-glass-border bg-glass-secondary">
                      <CardContent className="px-4 py-3">
                        <p className="text-xs uppercase tracking-widest text-muted-foreground">
                          Trade impact
                        </p>
                        <p className="mt-1">
                          Donations are tracked for tie-breaks and narrative insight.
                        </p>
                      </CardContent>
                    </Card>
                  </li>
                </ul>
              </CardContent>
            </Card>

            <Card className="bg-glass-panel backdrop-blur border-glass-border shadow-xl">
              <CardHeader className="px-6 py-6 md:px-8 md:py-7">
                <CardTitle className="text-xl">
                  Focus overview
                </CardTitle>
              </CardHeader>
              <CardContent className="px-6 pb-6 md:px-8 md:pb-7">
                {focusAgent ? (
                  <div className="space-y-4 text-sm text-muted-foreground">
                    <p>
                      <span className="font-semibold text-foreground">
                        Agent
                      </span>
                      : {focusAgent.name} ({focusAgent.role})
                    </p>
                    <p>
                      <span className="font-semibold text-foreground">
                        Cooperation bias
                      </span>
                      : {focusAgent.sentiment}
                    </p>
                    <p>
                      <span className="font-semibold text-foreground">
                        Preferred partner
                      </span>
                      : {focusAgent.preferredPartner}
                    </p>
                    <p>
                      <span className="font-semibold text-foreground">
                        Efficiency
                      </span>
                      : {Math.round(focusAgent.efficiency * 100)}%
                    </p>
                    <p>
                      <span className="font-semibold text-foreground">
                        Pond impact
                      </span>
                      : {Math.round(focusAgent.pondImpact * 100)}%
                    </p>
                    <p className="text-xs text-muted-foreground">
                      Use this view to brief human observers or switch AI policies
                      mid-experiment.
                    </p>
                  </div>
                ) : (
                  <CardDescription>
                    Select an agent above to review their cooperation profile,
                    preferred trading partners, and efficiency stats at a glance.
                  </CardDescription>
                )}
              </CardContent>
            </Card>
          </aside>
        </section>
      </div>
    </main>
  )
}

function FilterButton({
  label,
  isActive,
  onClick,
}: {
  label: string
  isActive: boolean
  onClick: () => void
}) {
  return (
    <Button
      type="button"
      variant={isActive ? "default" : "outline"}
      onClick={onClick}
      className={`rounded-full px-4 py-2 text-xs font-semibold uppercase tracking-widest transition ${
        isActive
          ? 'bg-primary/90 text-primary-foreground shadow'
          : 'bg-glass-card border-glass-border hover:border-primary/30 hover:text-primary'
      }`}
    >
      {label}
    </Button>
  )
}

function StatItem({
  label,
  value,
  accent,
}: {
  label: string
  value: string | number
  accent?: string
}) {
  return (
    <div>
      <dt className="text-xs uppercase tracking-widest text-muted-foreground">
        {label}
      </dt>
      <dd
        className={`mt-1 text-sm font-semibold ${accent ?? 'text-muted-foreground'}`}
      >
        {value}
      </dd>
    </div>
  )
}

function Bar({
  label,
  value,
  maxValue,
  gradient,
}: {
  label: string
  value: number
  maxValue: number
  gradient: string
}) {
  const width = Math.max(8, Math.round((value / Math.max(1, maxValue)) * 100))

  return (
    <div className="space-y-1">
      <div className="flex items-center justify-between text-xs uppercase tracking-widest text-muted-foreground">
        <span>{label}</span>
        <span>{value}</span>
      </div>
      <div className="h-2 w-full overflow-hidden rounded-full bg-muted/30">
        <div
          className={`h-full bg-gradient-to-r ${gradient}`}
          style={{ width: `${width}%` }}
        />
      </div>
    </div>
  )
}

function StatusPill({ status }: { status: CommLog['status'] }) {
  const customClass =
    status === 'Accepted'
      ? 'bg-emerald-100/80 text-emerald-600 border-emerald-200/70 dark:bg-emerald-950/30 dark:text-emerald-400 dark:border-emerald-900/60'
      : status === 'Declined'
        ? 'bg-rose-100/70 text-rose-600 border-rose-200/70 dark:bg-rose-950/30 dark:text-rose-400 dark:border-rose-900/60'
        : 'bg-amber-100/70 text-amber-600 border-amber-200/70 dark:bg-amber-950/30 dark:text-amber-400 dark:border-amber-900/60'

  return (
    <Badge variant="outline" className={`uppercase tracking-widest ${customClass}`}>
      {status}
    </Badge>
  )
}
